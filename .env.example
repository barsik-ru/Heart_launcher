# Только для локальной разработки. Не включать в production.
VITE_USE_MOCKS=false

# Unified Heart Network backend (account API + news/modpack API).
# Outside localhost HTTPS is mandatory. The value is embedded into the packaged Main process at build time.
VERDANT_API_BASE_URL=https://heartserverm.duckdns.org:27015

# Minecraft Java Server List Ping (public Velocity address)
VERDANT_MINECRAFT_HOST=87.228.56.12
VERDANT_MINECRAFT_PORT=25565

# HeartBridge Velocity API; same HTTPS origin also serves the account API.
HEART_BRIDGE_API_BASE_URL=https://heartserverm.duckdns.org:27015

# Optional comma-separated aliases which the client companion accepts for the same server
VERDANT_MINECRAFT_ALIASES=heartserverm.duckdns.org:25565
