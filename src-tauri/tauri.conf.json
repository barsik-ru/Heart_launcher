{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heart Launcher",
  "version": "0.4.1",
  "identifier": "com.heart.launcher",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Heart Launcher",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icon.ico"
    ]
  }
}